*.pdf filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text

# Anything under platform/public/ is served directly by the deployed app
# (Vercel serves public/ verbatim from the git checkout) and Vercel's git
# integration does not fetch LFS objects — an LFS-tracked file here
# deploys as a ~130-byte pointer stub instead of its real bytes, which is
# exactly what broke /paes's PDFs ("Failed to load PDF document"). Kept as
# plain git blobs instead, unset here since a later, more specific pattern
# overrides the earlier `*.pdf` LFS rule above for these paths.
platform/public/** -filter -diff -merge -text
