{
  "name": "abeliever-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "check": "npm run typecheck && npm test",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "migrate": "tsx scripts/migrate.ts",
    "content:export": "tsx scripts/export-content.ts",
    "deploy": "npm run check && npm run migrate && wrangler deploy"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
