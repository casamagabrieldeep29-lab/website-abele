# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is already gitignored.

# Supabase project settings — find these in your Supabase project's
# Settings > API page. NEXT_PUBLIC_* values are safe to expose to the browser
# (Supabase's anon key is designed for that); NEVER put the service_role key
# in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build magic-link redirect URLs. Use http://localhost:3000 for local
# dev; set to the deployed Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role key — server-side only, used later for the admin invite flow
# (creating users). NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Manual-payment receiving accounts shown on /upgrade — not secrets (they're
# exactly what a student needs to pay), just not needed in client JS. Leave
# any pair unset and that method shows "Not configured yet" instead of
# breaking the page.
GCASH_ACCOUNT_NAME=
GCASH_ACCOUNT_NUMBER=
MAYA_ACCOUNT_NAME=
MAYA_ACCOUNT_NUMBER=
LANDBANK_ACCOUNT_NAME=
LANDBANK_ACCOUNT_NUMBER=
